{
  "name": "applypilot",
  "version": "0.3.0",
  "private": true,
  "description": "Extensão Chrome local para gerenciar perfil profissional, analisar compatibilidade com vagas e preencher formulários de forma assistida.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
