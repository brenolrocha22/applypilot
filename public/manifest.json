{
  "manifest_version": 3,
  "name": "ApplyPilot",
  "version": "0.2.0",
  "description": "Perfil profissional, análise explicável de compatibilidade com vagas e preenchimento assistido — tudo local.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyPilot",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "app.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
